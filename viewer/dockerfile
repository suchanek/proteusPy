# RCSB Disulfide Viewer: a Panel app served on port 5006.
#
# Plain python:3.12-slim with pip, no conda: proteusPy from PyPI brings
# pyvista and vtk, and panel is the only other runtime dependency. VTK ships
# Linux wheels for both amd64 and arm64, so the same file builds both.
# PROTEUSPY_VERSION pins the release, so the pip layer rebuilds when the
# version changes and is reused from cache otherwise.

FROM python:3.12-slim

ARG PROTEUSPY_VERSION

LABEL org.opencontainers.image.source=https://github.com/suchanek/proteusPy
LABEL org.opencontainers.image.description="RCSB Disulfide Viewer"
LABEL org.opencontainers.image.licenses=BSD-3-Clause

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYVISTA_OFF_SCREEN=true \
    DOCKER_RUNNING=true \
    MPLCONFIGDIR=/tmp/matplotlib \
    PDB=/home/appuser

# Virtual display and the GL/X libraries the VTK wheel loads.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libgl1 \
        libegl1 \
        libglib2.0-0 \
        libxrender1 \
        libxext6 \
        procps \
        xvfb \
        xauth && \
    rm -rf /var/lib/apt/lists/*

# proteusPy needs torch through pydssp. The CPU-only build comes first: the
# PyPI torch for amd64 pulls several GB of CUDA libraries the viewer never uses.
RUN test -n "$PROTEUSPY_VERSION" && \
    pip install torch --index-url https://download.pytorch.org/whl/cpu && \
    pip install "proteusPy==${PROTEUSPY_VERSION}" "panel>=1.8.0"

RUN useradd -m appuser && \
    mkdir -p /tmp/matplotlib /app && \
    chown appuser:appuser /tmp/matplotlib /app

WORKDIR /app

# The database first: it is the largest layer and changes least often.
# --chown here, not a later chown -R, which would store it a second time.
COPY --chown=appuser:appuser data /app/data
COPY --chown=appuser:appuser --chmod=755 entrypoint.sh /app/
COPY --chown=appuser:appuser rcsb_viewer.py /app/

USER appuser

EXPOSE 5006

ENTRYPOINT ["/app/entrypoint.sh"]
